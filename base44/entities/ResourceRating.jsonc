{
  "name": "ResourceRating",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string",
      "description": "ID of the rated resource"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client rating the resource"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the client rating"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1-5 stars"
    },
    "feedback": {
      "type": "string",
      "description": "Client's feedback or comments"
    },
    "usefulness": {
      "type": "string",
      "enum": [
        "not_useful",
        "somewhat_useful",
        "very_useful",
        "extremely_useful"
      ],
      "description": "How useful was this resource"
    },
    "difficulty_match": {
      "type": "string",
      "enum": [
        "too_easy",
        "just_right",
        "too_hard"
      ],
      "description": "Whether difficulty matched client level"
    },
    "relevance": {
      "type": "string",
      "enum": [
        "not_relevant",
        "somewhat_relevant",
        "very_relevant",
        "perfect_match"
      ],
      "description": "How relevant to client's goals"
    },
    "would_recommend": {
      "type": "boolean",
      "description": "Would the client recommend this to others"
    },
    "improvement_notes": {
      "type": "string",
      "description": "Suggestions for improvement"
    }
  },
  "required": [
    "resource_id",
    "client_id",
    "client_email",
    "rating"
  ]
}