{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "coach_email": {
      "type": "string",
      "description": "Email of the health coach"
    },
    "coach_name": {
      "type": "string",
      "description": "Name of the health coach"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "basic",
        "advanced",
        "pro"
      ],
      "description": "White-label subscription plan tier"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "description": "Billing frequency"
    },
    "amount": {
      "type": "number",
      "description": "Subscription amount"
    },
    "currency": {
      "type": "string",
      "default": "INR"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired",
        "trial"
      ],
      "default": "active"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "razorpay",
        "stripe",
        "bank_transfer",
        "cash"
      ]
    },
    "transaction_id": {
      "type": "string"
    },
    "razorpay_subscription_id": {
      "type": "string",
      "description": "Razorpay subscription ID for recurring payments"
    },
    "features": {
      "type": "object",
      "description": "Features included in this plan",
      "properties": {
        "client_limit": {
          "type": "number",
          "default": -1,
          "description": "-1 for unlimited"
        },
        "can_add_payment_gateway": {
          "type": "boolean",
          "default": false
        },
        "can_add_custom_domain": {
          "type": "boolean",
          "default": false
        },
        "white_label_enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "auto_renew": {
      "type": "boolean",
      "default": true
    },
    "discount_code": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "coach_email",
    "plan_type",
    "amount",
    "start_date"
  ]
}