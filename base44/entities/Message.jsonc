{
  "name": "Message",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client (for 1-to-1 messages)"
    },
    "group_id": {
      "type": "string",
      "description": "ID of group (for group messages)"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "dietitian",
        "client"
      ],
      "description": "Who sent the message"
    },
    "sender_id": {
      "type": "string",
      "description": "ID of the sender (user or client)"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "photo",
        "video",
        "audio",
        "poll"
      ],
      "default": "text",
      "description": "Type of content being shared"
    },
    "attachment_url": {
      "type": "string",
      "description": "URL of attached file"
    },
    "attachment_name": {
      "type": "string",
      "description": "Original filename of attachment"
    },
    "attachment_type": {
      "type": "string",
      "description": "MIME type of attachment"
    },
    "attachment_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "poll_data": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "Poll question"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "votes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string"
                    },
                    "user_name": {
                      "type": "string"
                    },
                    "voted_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "allow_multiple": {
          "type": "boolean",
          "default": false,
          "description": "Allow voting for multiple options"
        },
        "is_anonymous": {
          "type": "boolean",
          "default": false,
          "description": "Hide voter names"
        }
      },
      "description": "Poll data if content_type is poll"
    },
    "file_version_id": {
      "type": "string",
      "description": "ID of file version for secure tracking"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    },
    "is_important": {
      "type": "boolean",
      "default": false,
      "description": "Mark as important for read receipts"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "read_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Track who read important messages and when"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time",
      "description": "Schedule message for later delivery"
    },
    "is_scheduled": {
      "type": "boolean",
      "default": false,
      "description": "Is this message scheduled"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether message is pinned in group"
    },
    "pinned_by": {
      "type": "string",
      "description": "Email of user who pinned the message"
    },
    "pinned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When message was pinned"
    },
    "parent_message_id": {
      "type": "string",
      "description": "ID of parent message for threaded replies"
    },
    "thread_count": {
      "type": "number",
      "default": 0,
      "description": "Number of replies in thread"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user/client IDs mentioned in message"
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          }
        }
      },
      "description": "Emoji reactions to message"
    }
  },
  "required": [
    "sender_type"
  ]
}