{
  "name": "HealthyfyKnowledgeBase",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Resource name / document title"
    },
    "description": {
      "type": "string",
      "description": "What this document contains and how the AI should use it"
    },
    "category": {
      "type": "string",
      "enum": [
        "Clinical Guidelines",
        "Meal Planning Rules",
        "Dish & Nutrient Databases",
        "Macro & Calorie Formulas",
        "Other"
      ],
      "description": "Category of the knowledge resource"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "PDF",
        "Excel",
        "CSV",
        "Word",
        "Other"
      ],
      "description": "Type of file"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded file"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the AI meal plan generator should refer to this document"
    },
    "ai_instruction": {
      "type": "string",
      "description": "Specific instruction to the AI on how to use this document"
    },
    "version": {
      "type": "string",
      "description": "Current version label (e.g. v3, April 2026)"
    },
    "version_number": {
      "type": "number",
      "default": 1,
      "description": "Auto-incrementing integer version counter"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within its category"
    },
    "change_log": {
      "type": "array",
      "description": "Full history of all changes made to this KB entry",
      "items": {
        "type": "object",
        "properties": {
          "version_number": {
            "type": "number"
          },
          "version_label": {
            "type": "string"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "changed_by": {
            "type": "string"
          },
          "change_summary": {
            "type": "string"
          },
          "snapshot": {
            "type": "object",
            "description": "Full state of the record at this version",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "file_type": {
                "type": "string"
              },
              "file_url": {
                "type": "string"
              },
              "ai_instruction": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "is_active": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "name",
    "category",
    "file_type"
  ]
}