{
  "name": "FavoriteRecipe",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email of the client who favorited the recipe"
    },
    "recipe_id": {
      "type": "string",
      "description": "ID of the favorited recipe"
    },
    "recipe_name": {
      "type": "string",
      "description": "Name of the recipe for quick reference"
    },
    "user_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "User's personal rating (1-5 stars)"
    },
    "personal_notes": {
      "type": "string",
      "description": "Personal notes about the recipe"
    },
    "times_cooked": {
      "type": "number",
      "default": 0,
      "description": "How many times user has cooked this recipe"
    },
    "last_cooked_date": {
      "type": "string",
      "format": "date",
      "description": "Last date when recipe was cooked"
    },
    "dietary_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags added by user for quick filtering"
    }
  },
  "required": [
    "client_email",
    "recipe_id"
  ]
}