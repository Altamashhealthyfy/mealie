{
  "name": "ClientFeedback",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client providing feedback"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the client"
    },
    "coach_email": {
      "type": "string",
      "description": "Email of the assigned coach"
    },
    "coach_name": {
      "type": "string",
      "description": "Name of the coach"
    },
    "overall_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Overall satisfaction rating (1-5 stars)"
    },
    "testimonial_text": {
      "type": "string",
      "description": "Client's testimonial or feedback text"
    },
    "transformation_highlight": {
      "type": "string",
      "description": "Key transformation or result achieved (e.g. Lost 10kg, Reversed diabetes)"
    },
    "image_url": {
      "type": "string",
      "description": "Before/after or progress photo URL uploaded by client"
    },
    "would_recommend": {
      "type": "boolean",
      "description": "Would recommend this coach/platform"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Coach review status of the testimonial"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether coach has featured this testimonial"
    },
    "coach_reply": {
      "type": "string",
      "description": "Coach's reply or response to the testimonial"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of coach who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When testimonial was reviewed"
    }
  },
  "required": [
    "client_id",
    "coach_email",
    "overall_rating",
    "testimonial_text"
  ]
}